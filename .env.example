EVE_ENV=development
EVE_AUTH_MODE=dev
EVE_DEV_TOKENS={"dev-noah-token":"noah-dev-subject"}
EVE_LITELLM_BASE_URL=https://litellm.chalifour.dev
EVE_LITELLM_API_KEY=sk-replace-me

# Aegra. Ports match docker-compose.test.yml, which deliberately publishes
# 15432/16379 rather than the defaults so it doesn't collide with whatever
# else is running locally. AUTH_TYPE selects Aegra's auth backend and must be
# "custom" for any deployment - see docs/architecture.md.
AUTH_TYPE=custom
DATABASE_URL=postgresql://eve:eve@localhost:15432/eve
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://localhost:16379/0

# Observability (leave OTEL_TARGETS unset locally to disable tracing)
# OTEL_TARGETS=LANGFUSE
# LANGFUSE_BASE_URL=https://langfuse.chalifour.dev
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Memory (Phase 2). EVE_DATABASE_URL defaults to DATABASE_URL above, so it
# only needs setting when memory lives in a different database from Aegra's
# own tables - which it does not, today.
# EVE_DATABASE_URL=postgresql://eve:eve@localhost:15432/eve
# EVE_MEMORY_TOKEN_BUDGET=1200
# EVE_MEMORY_RECALL_EMBED_BUDGET_MS=120

# Phase 3 (Specialists + Skills). Eve's side: where the eve-tools service
# lives and the bearer token it is called with. The default base URL is the
# in-cluster service name; point it at localhost when running eve-tools
# yourself. EVE_TOOLS_API_KEY is deliberately the SAME env var name on both
# sides - it is one shared secret, read by eve.settings.Settings.tools_api_key
# here and by eve_tools.settings.ToolsSettings.api_key in the other process.
EVE_TOOLS_BASE_URL=http://localhost:8090
EVE_TOOLS_API_KEY=replace-me
# EVE_MAX_TOOL_LOOP_ITERATIONS=6

# eve-tools' side. A local dev setup runs both processes, but only this
# service ever sees these third-party credentials (ADR 0006) - do not put
# them in the environment of the main eve-ai container.
EVE_TOOLS_HOME_ASSISTANT_URL=http://homeassistant.local:8123
EVE_TOOLS_HOME_ASSISTANT_TOKEN=replace-me
# Contents of the Google OAuth client JSON, inline (not a path).
EVE_TOOLS_GMAIL_CREDENTIALS_JSON={}
EVE_TOOLS_MONARCH_EMAIL=replace-me@example.com
EVE_TOOLS_MONARCH_PASSWORD=replace-me
