EVE_ENV=development
EVE_AUTH_MODE=dev
EVE_DEV_TOKENS={"dev-noah-token":"noah-dev-subject"}
EVE_LITELLM_BASE_URL=https://litellm.chalifour.dev
EVE_LITELLM_API_KEY=sk-replace-me

# Aegra. Ports match docker-compose.test.yml, which deliberately publishes
# 15432/16379 rather than the defaults so it doesn't collide with whatever
# else is running locally. AUTH_TYPE selects Aegra's auth backend and must be
# "custom" for any deployment - see docs/architecture.md.
AUTH_TYPE=custom
DATABASE_URL=postgresql://eve:eve@localhost:15432/eve
REDIS_BROKER_ENABLED=true
REDIS_URL=redis://localhost:16379/0

# Observability (leave OTEL_TARGETS unset locally to disable tracing)
# OTEL_TARGETS=LANGFUSE
# LANGFUSE_BASE_URL=https://langfuse.chalifour.dev
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
